{
  "name": "astrowhiteboard",
  "version": "1.0.0",
  "description": "A collaborative whiteboard application",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "lint": "eslint .",
    "db:init": "node database/init-db.js",
    "db:seed": "node database/init-db.js --seed",
    "db:reset": "node database/init-db.js --force --seed",
    "db:migrate": "node database/migrations/migration-runner.js up",
    "db:migrate:down": "node database/migrations/migration-runner.js down",
    "db:migrate:status": "node database/migrations/migration-runner.js status",
    "db:migrate:create": "node database/migrations/generate.js"
  },
  "keywords": [
    "whiteboard",
    "collaboration",
    "drawing",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.0",
    "redis": "^4.6.6",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "eslint": "^8.41.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}