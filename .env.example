# AstroWhiteboard Environment Variables Example
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astrowhiteboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourdad
POSTGRES_MAX_CLIENTS=20
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_SSL_CA=
POSTGRES_SSL_CERT=
POSTGRES_SSL_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Encryption Keys
MASTER_ENCRYPTION_KEY=your-master-encryption-key
DATA_ENCRYPTION_KEY=your-data-encryption-key

# AWS Configuration (if using S3 for storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=astrowhiteboard-uploads

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_E2E_ENCRYPTION=true
ENABLE_VERSION_HISTORY=true