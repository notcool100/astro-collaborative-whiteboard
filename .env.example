# PCS Draw Environment Variables Example
# Copy this file to .env and fill in the values

# Node Environment
# Options: development, production, test
NODE_ENV=development

# Server Configuration
# Port the server will run on
PORT=3001
# URL for the API (used for generating links)
API_URL=http://localhost:3001
# URL for the client application (for CORS)
CLIENT_URL=http://localhost:3000
# CORS origin - can be a single URL or comma-separated list
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Configuration
# Host where PostgreSQL is running
POSTGRES_HOST=localhost
# Port PostgreSQL is running on
POSTGRES_PORT=5432
POSTGRES_DB=astrowhiteboard
POSTGRES_USER=postgres
# Database password
POSTGRES_PASSWORD=your_password_here
# Maximum number of clients in the connection pool
POSTGRES_MAX_CLIENTS=20
# Whether to use SSL for database connections
POSTGRES_SSL=false
# SSL options (only used if POSTGRES_SSL=true)
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_SSL_CA=
POSTGRES_SSL_CERT=
POSTGRES_SSL_KEY=

# Redis Configuration
# Whether to enable Redis (set to false to use mock Redis client)
REDIS_ENABLED=false
# Host where Redis is running
REDIS_HOST=localhost
# Port Redis is running on
REDIS_PORT=6379
# Redis password (if required)
REDIS_PASSWORD=
# Redis database number
REDIS_DB=0
# Whether to use TLS for Redis connections
REDIS_TLS=false
# Redis URI (alternative to host/port/password)
# REDIS_URI=redis://username:password@host:port

# JWT Configuration
# Secret key for signing JWTs (change this in production!)
JWT_SECRET=your-secret-key-change-in-production
# JWT token expiration time
JWT_EXPIRATION=24h
# JWT refresh token expiration time
JWT_REFRESH_EXPIRATION=7d

# Encryption Keys (for end-to-end encryption)
# Master key for encrypting other keys
MASTER_ENCRYPTION_KEY=your-master-encryption-key-change-in-production
# Key for encrypting data
DATA_ENCRYPTION_KEY=your-data-encryption-key-change-in-production

# Storage Configuration
# Storage type: local, s3
STORAGE_TYPE=local
# Local storage path (only used if STORAGE_TYPE=local)
STORAGE_LOCAL_PATH=uploads
# S3 configuration (only used if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=pcsdraw-uploads

# Logging Configuration
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
# Path to log file (optional)
LOG_FILE_PATH=logs/app.log
# Whether to log to console
LOG_TO_CONSOLE=true

# Rate Limiting
# Time window for rate limiting in milliseconds
RATE_LIMIT_WINDOW_MS=60000
# Maximum number of requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
# Whether to enable WebSockets for real-time collaboration
ENABLE_WEBSOCKETS=true
# Whether to enable end-to-end encryption
ENABLE_E2E_ENCRYPTION=false
# Whether to enable version history
ENABLE_VERSION_HISTORY=true
# Whether to enable public sharing
ENABLE_PUBLIC_SHARING=true