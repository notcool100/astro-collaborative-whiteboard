# PCS Draw Environment Variables Example
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pcsdraw
MONGODB_POOL_SIZE=10
MONGODB_SSL=false
MONGODB_SSL_VALIDATE=false
MONGODB_SSL_CA=
MONGODB_SSL_CERT=
MONGODB_SSL_KEY=
MONGODB_READ_PREFERENCE=primary

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Encryption Keys
MASTER_ENCRYPTION_KEY=your-master-encryption-key
DATA_ENCRYPTION_KEY=your-data-encryption-key

# AWS Configuration (if using S3 for storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=pcsdraw-uploads

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_E2E_ENCRYPTION=true
ENABLE_VERSION_HISTORY=true